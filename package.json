{
  "name": "@local/dsh-ui",
  "version": "1.1.41",
  "description": "DeepSeek Harness 视觉皮肤与输入栏交互增强",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "pretest": "node build.mjs",
    "test": "node --test tests/bridge.test.mjs tests/home-drawer.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "client-app.js",
    "styles.css",
    "build.mjs",
    "bridge.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
